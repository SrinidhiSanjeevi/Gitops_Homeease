# Local scratch from `kustomize build` / `kubectl kustomize` dry-runs
# during review — never committed.
/.render/

# Personal, machine-local Kustomize overrides (e.g. testing a patch before
# it's ready to commit). Never used by ArgoCD — if a value needs to be
# real for ArgoCD to deploy it, it belongs in a committed overlay file,
# not here.
kustomization.local.yaml
*.local.yaml

